<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
        crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <h1>
            <%= title %>
        </h1>
        <form method="post">
            <input class="form-control w-12" type="text" name="name" placeholder="Név"> <br>
            <input class="form-control w-12" type="text" name="email" placeholder="Email"
                pattern="^[a-zA-Z0-9.%+-]+@[a-zA-Z0-9.-]+.[a-zA-Z]{2,}$"><br>
            <input class="form-control w-12" type="datetime-local" name="startDate" placeholder="Dátum"><br>
            <input class="form-control w-12" type="number" name="guests" placeholder="Nézők" min="1" max="10"><br>
            <button class="btn" type="submit">Küldés</button> 
        </form><br>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Név</th>
                <th>E-mail</th>
                <th>Dátum és időpont</th>
                <th>Nézők vagy vendégek száma</th>
            </tr>
        </thead>
        <tbody>
            <% foglalasok.forEach(item=> { %>
                <tr>
                    <td>
                        <%= item.name %>
                    </td>
                    <td>
                        <%= item.email %>
                    </td>
                    <td>
                        <%= item.startDate %>
                    </td>
                    <td>
                        <%= item.guests %>
                    </td>
                </tr>
                <% }); %>
        </tbody>
    </table>


</body>

</html>