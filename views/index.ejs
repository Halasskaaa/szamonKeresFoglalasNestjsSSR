<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <h1> <%= title %> </h1>
        <h2><%= count %></h2>
        <form method="post" class="form">
            <input class="form-control" type="text" name="name" placeholder="Név" required> <br>
            <input class="form-control" type="text" name="email" placeholder="Email"
                pattern="^[a-zA-Z0-9.%+-]+@[a-zA-Z0-9.-]+.[a-zA-Z]{2,}$" required><br>
            <input class="form-control" type="datetime-local" name="startDate" placeholder="Dátum" required><br>
            <input class="form-control" type="number" name="guests" placeholder="Nézők" min="1" max="10"
                required><br>
            <button id="myBtn" class="btn" type="submit">Küldés</button>
        </form><br>


        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Név</th>
                    <th>E-mail</th>
                    <th>Dátum és időpont</th>
                    <th>Nézők vagy vendégek száma</th>
                </tr>
            </thead>
            <tbody>
                <% foglalasok.forEach(item=> { %>
                    <tr>
                        <td>
                            <%= item.name %>
                        </td>
                        <td>
                            <%= item.email %>
                        </td>
                        <td>
                            <%= item.startDate %>
                        </td>
                        <td>
                            <%= item.guests %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>
</body>

</html>